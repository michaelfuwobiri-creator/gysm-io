# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (used by lib/ai/orchestrator.ts to generate sites)
OPENAI_API_KEY=

# Stripe (Developers -> API keys)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs -- one per plan in lib/stripe.ts PRICING_PLANS
# Products -> (each product) -> Pricing -> copy the price ID (starts with price_)
STRIPE_STARTER_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
STRIPE_CREDITS_10_PRICE_ID=
STRIPE_CREDITS_30_PRICE_ID=

# Used for OG tags, Stripe redirect URLs, etc. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.gysm.io
