# Clerk (Dashboard -> API Keys) -- this app's login system.
# Use LIVE keys (pk_live_ / sk_live_) once you're pointing at gysm.io in
# production; test keys (pk_test_ / sk_test_) only work against Clerk's
# test/dev instance and will break auth on a real domain.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Dashboard -> Webhooks -> your endpoint -> Signing Secret
# (endpoint should point at /api/webhooks/clerk)
CLERK_WEBHOOK_SECRET=

# Neon Postgres -- the only database this app uses (see lib/db.ts and
# db/migrations/0001_init.sql). Holds users (synced from Clerk), projects,
# credits, and subscriptions.
DATABASE_URL=

# OpenAI (used by lib/ai/orchestrator.ts to generate the working app --
# structure, content, interactivity)
OPENAI_API_KEY=

# Gemini (used by lib/ai/orchestrator.ts for the visual design pass on
# top of OpenAI's output -- spacing, color, polish. Optional: if unset,
# generation still works, it just skips the extra design pass.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Stripe (Developers -> API keys)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Developers -> Webhooks -> your endpoint -> Signing secret
# (endpoint should point at /api/billing/webhook)
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs -- one per plan in lib/stripe.ts PRICING_PLANS
# Products -> (each product) -> Pricing -> copy the price ID (starts with price_)
STRIPE_STARTER_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
STRIPE_CREDITS_10_PRICE_ID=
STRIPE_CREDITS_30_PRICE_ID=

# "Connect database" -- lets a user link their own Supabase project to a
# build (see app/api/backend/*, lib/supabaseBackend.ts). Requires an OAuth
# App registered at https://supabase.com/dashboard/org/_/apps (any org).
# Redirect URI must be exactly {NEXT_PUBLIC_SITE_URL}/api/backend/callback.
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
SUPABASE_OAUTH_REDIRECT_URI=https://www.gysm.io/api/backend/callback

# Encrypts stored Supabase OAuth tokens + db passwords at rest (see
# lib/crypto.ts). Must be a 32-byte key, base64-encoded. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKEND_ENCRYPTION_KEY=

# Used for OG tags, Stripe redirect URLs, etc. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.gysm.io

# ============================================================================
# VOIIE -- Hunter + Closer + Builder (see /voiie, lib/voiie/*,
# db/migrations/0016_voiie.sql). Reuses everything above (Neon, Clerk,
# Stripe, lib/ai/orchestrator.ts) -- these are the genuinely new pieces.
# ============================================================================

# Stripe Price IDs for the VOIIE-only plans in lib/stripe.ts PRICING_PLANS
# (hidden: true -- not on /pricing, quoted per-lead from the /voiie
# dashboard's Payment tab). Same "Products -> price -> copy the id" steps
# as the STRIPE_*_PRICE_ID vars above.
STRIPE_VOIIE_STARTER_PRICE_ID=
STRIPE_VOIIE_PRO_PRICE_ID=
STRIPE_VOIIE_AGENCY_PRICE_ID=

# Which GYSM.IO account (Clerk user id, e.g. "user_2abc...") owns hunted
# leads when there's no signed-in dashboard session to attribute them to
# -- the Vercel Cron hunt sweep (app/api/voiie/cron/hunt/route.ts) and the
# inbound WhatsApp/Twitter webhooks all need this. Find your own id under
# Clerk Dashboard -> Users -> (you) -> User ID. Single-operator today; see
# db/migrations/0016_voiie.sql's comment on voiie_leads.owner_user_id for
# what a multi-operator setup would need instead.
VOIIE_OWNER_USER_ID=

# Authenticates Vercel Cron's requests to app/api/voiie/cron/*
# (Vercel signs them with this as an Authorization: Bearer header
# automatically once set -- see
# https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# Resend (https://resend.com/api-keys) -- email outreach channel
# (lib/voiie/outreach.ts). Verify the "voiie@gysm.io" sending domain
# there before going live, or change the `from` address in outreach.ts.
RESEND_API_KEY=

# WhatsApp Business (Meta for Developers -> your app -> WhatsApp -> API
# Setup for phone id + a temporary token; generate a permanent token via
# a System User under Business Settings). Configure the webhook
# (Configuration -> Webhook) to point at
# {NEXT_PUBLIC_SITE_URL}/api/voiie/webhooks/whatsapp, subscribe to the
# "messages" field, and set WHATSAPP_VERIFY_TOKEN to whatever string you
# put in the "Verify token" field there.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
# App Dashboard -> Settings -> Basic -> App Secret -- signs inbound
# webhook payloads (X-Hub-Signature-256).
WHATSAPP_APP_SECRET=

# Twitter/X API v2 (developer.twitter.com -> Project + App, Elevated/Pro
# access -- DM endpoints need at least the Basic paid tier). Bearer token
# is app-only (search); the four API_KEY/SECRET + ACCESS_TOKEN/SECRET
# pairs are OAuth 1.0a user-context keys for your outreach account
# (needed to send DMs). Account Activity API webhook (for inbound DM
# replies) points at {NEXT_PUBLIC_SITE_URL}/api/voiie/webhooks/twitter.
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Meta Threads API (Meta for Developers -> Threads API). Optional --
# hunting/outreach still works off Twitter/X alone if unset (see
# lib/voiie/threads.ts, which degrades gracefully).
THREADS_ACCESS_TOKEN=

# Google Places API (New) -- lib/voiie/places.ts. Finds real local
# businesses (by category + location, e.g. "plumbers in Austin, TX")
# that have no website on file: a much higher-intent, higher-volume lead
# source than social search, and doesn't depend on X's billing setup.
# Setup: console.cloud.google.com -> enable "Places API (New)" -> create
# an API key (restrict it to Places API). Needs a Cloud Billing account
# attached, but the first 1,000 calls/month (at the field tier that
# includes websiteUri) are free -- nothing charged until that's exceeded.
# Optional -- hunting still works off Twitter/Threads alone if unset (see
# lib/voiie/places.ts, which degrades gracefully).
GOOGLE_PLACES_API_KEY=

# Category + location for the unattended daily cron sweep's Places source
# (app/api/voiie/cron/hunt/route.ts), e.g. "plumbers in Austin, TX".
# Optional -- leave unset and the cron sweep just runs Twitter/Threads,
# same as before. The dashboard's "Hunt Now" button has its own Places
# location field and doesn't need this set.
VOIIE_PLACES_QUERY=

# PostHog (product analytics -- app/components/AnalyticsGate.tsx, lib/analytics/track.ts).
# Setup: app.posthog.com -> Project Settings -> Project API Key (the public
# "phc_..." key, safe client-side -- NOT the personal/server key).
# NEXT_PUBLIC_POSTHOG_HOST only needs to change for EU cloud / self-hosted.
# Optional -- unset just means PostHog never initializes.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Google Analytics 4 (app/components/AnalyticsGate.tsx). Setup:
# analytics.google.com -> Admin -> Data Streams -> your web stream ->
# Measurement ID ("G-..."). Optional, same degrade-gracefully pattern.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
