# Clerk (Dashboard -> API Keys) -- this app's login system.
# Use LIVE keys (pk_live_ / sk_live_) once you're pointing at gysm.io in
# production; test keys (pk_test_ / sk_test_) only work against Clerk's
# test/dev instance and will break auth on a real domain.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Dashboard -> Webhooks -> your endpoint -> Signing Secret
# (endpoint should point at /api/webhooks/clerk)
CLERK_WEBHOOK_SECRET=

# Neon Postgres -- the only database this app uses (see lib/db.ts and
# db/migrations/0001_init.sql). Holds users (synced from Clerk), projects,
# credits, and subscriptions.
DATABASE_URL=

# OpenAI (used by lib/ai/orchestrator.ts to generate the working app --
# structure, content, interactivity)
OPENAI_API_KEY=

# Gemini (used by lib/ai/orchestrator.ts for the visual design pass on
# top of OpenAI's output -- spacing, color, polish. Optional: if unset,
# generation still works, it just skips the extra design pass.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Stripe (Developers -> API keys)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Developers -> Webhooks -> your endpoint -> Signing secret
# (endpoint should point at /api/billing/webhook)
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs -- one per plan in lib/stripe.ts PRICING_PLANS
# Products -> (each product) -> Pricing -> copy the price ID (starts with price_)
STRIPE_STARTER_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
STRIPE_CREDITS_10_PRICE_ID=
STRIPE_CREDITS_30_PRICE_ID=

# Used for OG tags, Stripe redirect URLs, etc. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.gysm.io
